# Dependencies and build output
node_modules/
dist/

# The static files the host is handed. Written by the deploy, not by hand, and
# identical in content to dist/ — committing it would publish a second, staler
# copy of the bundle beside the sources it was built from.
isolate/

# Redacted learner papers, regenerated by `npm run gen:papers` (a pre-step of
# dev, typecheck and build). Never committed: it is derived from src/data/exams,
# and a stale copy in the repository would be a way to publish an old key.
src/data/learnerExams.generated.ts

# Runtime files written by scripts/dev-server.mjs
.dev/

# Plain-text extractions of the supplied course handouts, used while authoring
.extract/

# Course material supplied by the professor (session slides, examination training
# handout, exercise cases, previous year's quiz and corrigé). Copyrighted: kept on
# disk for authoring the mock exams, but never committed or published.
Financial Accounting/

# Portable single-file build
preview/studio.html

# Scratch output of the verification scripts
.verify/

# Local agent metadata
.freebuff/

# Editor and OS noise
.DS_Store
*.log

.env.local
