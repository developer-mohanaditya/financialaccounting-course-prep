{
  "name": "fa-mock-exam-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen:papers": "node scripts/build-learner-papers.mjs",
    "predev": "npm run gen:papers",
    "dev": "vite --configLoader native --host 0.0.0.0 --port ${PORT:-5173}",
    "predev:all": "npm run gen:papers",
    "dev:all": "node scripts/dev-all.mjs",
    "set:auth-keys": "node scripts/convex-auth-keys.mjs",
    "deploy:backend": "CONVEX_DEPLOYMENT=prod:adorable-civet-599 convex deploy",
    "dev:start": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:status": "node scripts/dev-server.mjs status",
    "dev:restart": "node scripts/dev-server.mjs restart",
    "prebuild": "npm run gen:papers",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "pretypecheck": "npm run gen:papers",
    "typecheck": "tsc -b",
    "verify:exams": "node scripts/verify-exams.mjs",
    "verify:grading": "node scripts/verify-grading.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:sync": "node scripts/verify-sync.mjs",
    "preview:single": "node scripts/build-single-file.mjs",
    "check": "npm run gen:papers && npm run typecheck && npm run verify:exams && npm run verify:grading && npm run verify:sync && npm run build && npm run verify:bundle"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "@oslojs/crypto": "^1.0.1",
    "convex": "^1.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
